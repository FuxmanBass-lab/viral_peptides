# ==============================================================
# viral_peptides — .gitignore
#
# The working tree is ~401 GB; almost all of it is raw sequencing
# data, alignments, and genome indices that must never be committed.
# Ten files exceed GitHub's hard 100 MB per-file limit.
#
# Strategy: ignore by EXTENSION first (so a stray FASTQ anywhere is
# caught), then by DIRECTORY, then re-include the small text inputs
# needed to reproduce the analysis.
# ==============================================================

# -------------------- raw sequencing data --------------------
*.fq
*.fq.gz
*.fastq
*.fastq.gz

# -------------------- alignments -----------------------------
*.bam
*.bai
*.sam
*.cram
*.crai

# -------------------- genome / index artifacts ---------------
*.fa
*.fasta
*.fa.gz
*.fasta.gz
*.gtf
*.gtf.gz
*.gff
*.gff3
genomes/

# -------------------- pipeline scratch -----------------------
# STARsolo output, sorted BAMs, staged FASTQ symlinks (109 GB)
workdir/

# -------------------- raw + bulky inputs ---------------------
data/fasta/
data/screen/

# -------------------- GEO submission bundle ------------------
# 139 GB of FASTQ plus matrices that are archived at GEO itself.
# METHODS.md was moved to the repo root and IS tracked.
GEO/

# -------------------- large derived matrices -----------------
# Byte-identical copies live in results/matrix, results/deseq2 and
# GEO/. They are deposited at GEO — see README "Data availability".
results/matrix/
results/deseq2/clean_filtered_count_matrix.tsv
results/deseq2/clean_filtered_cpm_matrix.tsv

# Per-comparison DESeq2 output (~50 MB across 31 tables).
# Regenerated by code/01_run_deseq2.r.
results/deseq2/tables/

# -------------------- unpublished findings -------------------
# Narrative summary of results — deliberately kept out of the repo.
results/ANALYSIS_SUMMARY.md

# -------------------- figure variants ------------------------
# Figures are generated in three variants: plots/ (the tracked,
# manuscript-styled set), poster/ (large-font) and draft/ (quick
# look, written by scripts 01, 05 and 06). Only plots/ is tracked.
results/deseq2/poster/
results/deseq2/draft/
results/gsea/reactome/poster/
results/gsea/reactome/draft/

# -------------------- misc -----------------------------------
# FastQC .zip duplicates the .html report, which is tracked
results/qc/*.zip

# Cluster scheduler logs and run output
logs/
*.out
*.err

# R / RStudio
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*~
.vscode/

# Local agent settings (machine-specific)
.claude/settings.local.json
